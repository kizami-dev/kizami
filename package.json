{
  "name": "kizami-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "pnpm --filter @kizami/docs dev",
    "docs:api": "node scripts/typedoc-validate.mjs",
    "docs:guide": "pnpm --filter @kizami/help-content build && node scripts/sync-help-docs.mjs",
    "docs:company": "node scripts/sync-company-docs.mjs",
    "docs:build": "pnpm docs:api && pnpm docs:guide && pnpm docs:company && pnpm --filter @kizami/docs build",
    "screenshots": "mise exec node@26 -- pnpm exec tsx scripts/screenshots/index.ts",
    "storybook": "pnpm --filter @kizami/web storybook",
    "storybook:build": "pnpm --filter @kizami/web storybook:build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.56.1",
    "temporal-polyfill": "^1.0.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
