{
  "name": "@kizami/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DB レイヤ — Drizzle ORM(SQLite 既定 / PostgreSQL 選択式 / Cloudflare D1) スキーマ・マイグレーション・クエリ",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts",
      "src/node.ts"
    ],
    "entryPointStrategy": "resolve"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "generate:pg": "node scripts/generate-pg.mjs",
    "migrate-data": "tsx src/migrate-data-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "4.124.0"
  }
}
