// KIZAMI API — Cloudflare Workers 配備(要件 §8「Workers+D1 動作保証」)。
//
// **このリポジトリからは自動デプロイしない。** CI で検証するのはビルドが通ることだけ:
//   pnpm --filter @kizami/api build:workers   (= wrangler deploy --dry-run --outdir dist-workers)
// 実配備の手順・制約(D1 に明示トランザクションが無い、Cron の CPU 時間・D1 のクエリ数の上限等)は
// docs/design/workers-d1.md にまとめてある。読まずに配備しないこと。
//
// マイグレーション: D1 は起動時ではなく **デプロイ時** に適用する。
//   npx wrangler d1 migrations apply kizami --remote
// migrations_dir は packages/db/migrations(SQLite レグと同じ .sql をそのまま使う)。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kizami-api",
  "main": "src/workers.ts",
  // vitest.workers.config.ts の COMPATIBILITY_DATE と揃えること(CI と本番で挙動差を出さない)
  "compatibility_date": "2026-08-01",
  // process.env(lib/encryption.ts 等の既定引数)と node:buffer 系の互換のために有効化する。
  // アプリ経路そのものは node:* を import していない(src/workers.ts の説明を参照)。
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 定期スキャン(Node の src/worker.ts に相当。docs/design/workers-d1.md「定期スキャン」)。
  // **src/workers-cron.ts の WORKERS_CRON_SCHEDULE と一字一句揃えること**(controller.cron は
  // この文字列のまま届く。食い違いは apps/api/test/scheduled-jobs.test.ts が落とす)。
  // UTC で評価されるが、どれも「15 分ごと」なので時差の換算は要らない。スキャン1本に1本ずつ、
  // 開始の分を1分ずつずらす(CPU 時間・D1 のクエリ数の上限が起動ごとに掛かるため)。
  // 7本あるので Workers Free(Cron はアカウントあたり5本・CPU 10ms)では配備できない — Paid が前提。
  // ローカルで試す: `wrangler dev` → curl "http://localhost:8787/cdn-cgi/local/scheduled?cron=0,15,30,45+*+*+*+*"
  "triggers": {
    "crons": [
      "0,15,30,45 * * * *", // 打刻忘れリマインド(reminder)
      "1,16,31,46 * * * *", // 36協定アラート(overtime-alert)
      "2,17,32,47 * * * *", // 有給の失効間近・年5日義務(leave-alert)
      "3,18,33,48 * * * *", // シフト予実乖離(shift-variance-alert)
      "4,19,34,49 * * * *", // 有給付与の予告(leave-grant-proposal)
      "5,20,35,50 * * * *", // 未確認サインアップ・再設定スロットルの掃除(signup-cleanup)
      "6,21,36,51 * * * *" // 退会テナントの再通知・物理削除(tenant-withdrawal)
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kizami",
      // 実際の ID は配備者が `wrangler d1 create kizami` で作って差し替える(dry-run には不要)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // システムメール(運用者名義のメール。Node の SYSTEM_SMTP_URL に相当 — docs/design/workers-d1.md「メール」)。
  // Cloudflare Email Service の Workers バインディング。使うときは差出人のドメインを Email Sending に登録し
  // (`npx wrangler email sending enable example.com`)、下の vars に SYSTEM_MAIL_FROM と APP_BASE_URL を足す。
  // 3つ(このバインディング・SYSTEM_MAIL_FROM・APP_BASE_URL)が揃わなければシステムメールは無効のまま。
  // 送り先を限りたいときは allowed_destination_addresses / allowed_sender_addresses を足せる。
  // `wrangler dev` では送らずにコンソールへ出す(本物を送るなら "remote": true)。
  "send_email": [{ "name": "EMAIL" }],
  // 秘密でない設定。秘密(KIZAMI_ENCRYPTION_KEY・VAPID_PRIVATE_KEY・METRICS_TOKEN・
  // SENTRY_DSN)は `wrangler secret put <NAME>` で入れること(ここに書かない)。
  //
  // システムメールを使うなら(上の send_email):
  //   "SYSTEM_MAIL_FROM": "KIZAMI <noreply@example.com>",
  //   "APP_BASE_URL": "https://kizami.example.com",
  // テナントの SMTP(通知のメール)は cloudflare:sockets で送る。ポート 25 は Workers から使えない(587 / 465)。
  // SSRF ガード(Node と同じ名前。Workers で効くのは名前と IP リテラルの検査だけ):
  //   "OUTBOUND_BLOCK_PRIVATE": "true", "OUTBOUND_DENY_CIDRS": "...", "OUTBOUND_ALLOW_HOSTS": "...
  //
  // 可観測性(../../docs/design/observability.md、任意):
  //   wrangler secret put METRICS_TOKEN   # 未設定なら GET /metrics は 404
  //   wrangler secret put SENTRY_DSN      # 未設定ならエラー報告は no-op
  // Node 版はリリース版を package.json から読むが、Workers では読めないので
  // KIZAMI_RELEASE を vars で渡す(未設定なら "unknown")。
  // workerd では process メトリクス(RSS・uptime)だけが取れず、他は Node 版と同じ。
  "vars": {
    "COOKIE_SECURE": "true",
    "TRUST_PROXY": "true",
    "KIZAMI_RELEASE": "unknown"
  }
}
