# 必須: 秘密情報(Webhook URL 等)の保存時暗号化鍵。`openssl rand -base64 32` で生成。
# 紛失すると保存済みの秘密が復号できなくなるので必ず控えること。
KIZAMI_ENCRYPTION_KEY=

# 初回セットアップ(docker compose run --rm seed)で作る初期管理者
KIZAMI_SEED_EMAIL=admin@example.com
KIZAMI_SEED_PASSWORD=
KIZAMI_SEED_TENANT_NAME=サンプル株式会社

# 2社目以降のテナント作成(docker compose run --rm create-tenant)で使う。1社運用なら不要。
#KIZAMI_TENANT_NAME=株式会社サンプル
#KIZAMI_TENANT_ADMIN_EMAIL=admin@sample.example.com
#KIZAMI_TENANT_ADMIN_PASSWORD=

# 任意
#KIZAMI_HTTP_PORT=8080          # 公開ポート(既定 8080)
# イメージタグ。既定は latest(最新を追う)。本番セルフホストでは版タグの固定を推奨
# (例 KIZAMI_TAG=0.8.1)。latest は再起動のたびに中身が変わりうる — 追従は自己責任。
# 版の一覧は https://github.com/kizami-dev/kizami/releases 、方針は docs/design/release-process.md
#KIZAMI_TAG=latest
#KIZAMI_WEBHOOK_URL=            # 管理者向け通知の Slack/Discord 互換 Webhook

# 任意: Web Push(ブラウザ通知)。`pnpm generate-vapid` で生成。未設定なら機能ごと非表示
#KIZAMI_VAPID_PUBLIC_KEY=
#KIZAMI_VAPID_PRIVATE_KEY=
#KIZAMI_VAPID_SUBJECT=mailto:admin@example.com

# 任意: セルフサインアップ(KIZAMI Cloud 向け、../../docs/design/saas.md)。既定は無効で、
# セルフホストでは設定しないこと。SIGNUP_MODE を invite / open にすると、下の5つがすべて必須になる
# (欠けていると api が起動時にエラー終了する)。開発・テストの Turnstile は Cloudflare 公式の
# テスト用キー(サイトキー 1x00000000000000000000AA / シークレット 1x0000000000000000000000000000000AA)。
#KIZAMI_SIGNUP_MODE=off                 # off(既定) / invite(招待コード制) / open(自由登録)
#KIZAMI_TURNSTILE_SECRET_KEY=
#KIZAMI_TURNSTILE_SITE_KEY=
#KIZAMI_SYSTEM_SMTP_URL=smtps://api_token:<token>@smtp.mx.cloudflare.net:465
#KIZAMI_SYSTEM_MAIL_FROM=KIZAMI <noreply@example.com>
#KIZAMI_APP_BASE_URL=https://kizami.example.com

# 任意: 監視(../../docs/design/observability.md)。どちらも未設定なら機能ごと無効。
# METRICS_TOKEN を設定すると GET /api/metrics(Prometheus text format 0.0.4)が開く。
# 未設定のあいだは 404 のままで、外からは有無すら分からない。
# 値は `openssl rand -hex 32` などで生成し、Prometheus 側の scrape_config に
# `authorization: {type: Bearer, credentials: "<同じ値>"}` を書く。
#KIZAMI_METRICS_TOKEN=
# エラー報告(Sentry プロトコル互換)の送り先。自前の sentry-relay / GlitchTip / Bugsink 等。
# 未設定なら外部へは何も送らない。リクエストボディ・メールアドレスは決して送られない。
#KIZAMI_SENTRY_DSN=https://<publicKey>@sentry.example.com/<projectId>
#KIZAMI_SENTRY_SERVER_NAME=kizami-prod     # 省略時はコンテナのホスト名
#KIZAMI_SENTRY_ENVIRONMENT=production      # 省略時は NODE_ENV

# 任意: 防御の強化(../../docs/design/outbound-ssrf.md、../../docs/design/tenant-quotas.md)。
# すべて未設定なら従来どおり(SSRF の検査なし・利用上限なし)。
# --- アプリ側の SSRF 対策: テナントが設定できる送り先(Webhook・SMTP・OIDC issuer・プッシュ)への接続を検査する ---
# true にすると、ループバック・プライベート(10/8・172.16/12・192.168/16)・リンクローカル(169.254/16、メタデータ)・
# CGNAT(100.64/10)・IPv6 の ULA/リンクローカル等への接続を拒否する。**社内 LAN の SMTP や Webhook を使うなら有効にしない**
# (使うなら下の ALLOW_HOSTS で許可するホストを列挙する)。api と worker の両方に同じ値が渡る。
#KIZAMI_OUTBOUND_BLOCK_PRIVATE=true
#KIZAMI_OUTBOUND_DENY_CIDRS=203.0.113.10/32,198.51.100.0/24   # 追加で拒否する宛先(カンマ区切りの CIDR / IP)
#KIZAMI_OUTBOUND_ALLOW_HOSTS=smtp.corp.example,*.hooks.corp.example   # プライベートな IP に解決されても許可するホスト
# --- テナントごとの利用上限(全テナント共通。未設定 = 無制限。打刻は止まらない。0 は「全部断る」) ---
#KIZAMI_QUOTA_MAX_MEMBERS=50                       # 在籍メンバー数(招待中を含む)
#KIZAMI_QUOTA_MAX_API_KEYS=20                      # 有効な API キー数
#KIZAMI_QUOTA_OUTBOUND_NOTIFICATIONS_PER_DAY=2000  # 外向きの通知(Webhook・メール)の1日の送信数(日本時間 0 時区切り)
#KIZAMI_QUOTA_INVITE_RESET_MAILS_PER_DAY=200       # 管理者の招待・パスワード再設定リンクの1日の発行数
