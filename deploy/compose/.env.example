# 必須: 秘密情報(Webhook URL 等)の保存時暗号化鍵。`openssl rand -base64 32` で生成。
# 紛失すると保存済みの秘密が復号できなくなるので必ず控えること。
KIZAMI_ENCRYPTION_KEY=

# 初回セットアップ(docker compose run --rm seed)で作る初期管理者
KIZAMI_SEED_EMAIL=admin@example.com
KIZAMI_SEED_PASSWORD=
KIZAMI_SEED_TENANT_NAME=サンプル株式会社

# 2社目以降のテナント作成(docker compose run --rm create-tenant)で使う。1社運用なら不要。
#KIZAMI_TENANT_NAME=株式会社サンプル
#KIZAMI_TENANT_ADMIN_EMAIL=admin@sample.example.com
#KIZAMI_TENANT_ADMIN_PASSWORD=

# 任意
#KIZAMI_HTTP_PORT=8080          # 公開ポート(既定 8080)
# イメージタグ。既定は latest(最新を追う)。本番セルフホストでは版タグの固定を推奨
# (例 KIZAMI_TAG=0.7.0)。latest は再起動のたびに中身が変わりうる — 追従は自己責任。
# 版の一覧は https://github.com/sasagar/kizami/releases 、方針は docs/design/release-process.md
#KIZAMI_TAG=latest
#KIZAMI_WEBHOOK_URL=            # 管理者向け通知の Slack/Discord 互換 Webhook

# 任意: Web Push(ブラウザ通知)。`pnpm generate-vapid` で生成。未設定なら機能ごと非表示
#KIZAMI_VAPID_PUBLIC_KEY=
#KIZAMI_VAPID_PRIVATE_KEY=
#KIZAMI_VAPID_SUBJECT=mailto:admin@example.com

# 任意: 監視(../../docs/design/observability.md)。どちらも未設定なら機能ごと無効。
# METRICS_TOKEN を設定すると GET /api/metrics(Prometheus text format 0.0.4)が開く。
# 未設定のあいだは 404 のままで、外からは有無すら分からない。
# 値は `openssl rand -hex 32` などで生成し、Prometheus 側の scrape_config に
# `authorization: {type: Bearer, credentials: "<同じ値>"}` を書く。
#KIZAMI_METRICS_TOKEN=
# エラー報告(Sentry プロトコル互換)の送り先。自前の sentry-relay / GlitchTip / Bugsink 等。
# 未設定なら外部へは何も送らない。リクエストボディ・メールアドレスは決して送られない。
#KIZAMI_SENTRY_DSN=https://<publicKey>@sentry.example.com/<projectId>
#KIZAMI_SENTRY_SERVER_NAME=kizami-prod     # 省略時はコンテナのホスト名
#KIZAMI_SENTRY_ENVIRONMENT=production      # 省略時は NODE_ENV
