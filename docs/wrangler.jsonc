// docs.kizami.dev — VitePress ドキュメントサイト(静的アセットのみの Worker)。
// デプロイ: pnpm docs:build && cd docs && npx wrangler deploy
{
  "name": "kizami-docs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".vitepress/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.kizami.dev", "custom_domain": true }
  ]
}
